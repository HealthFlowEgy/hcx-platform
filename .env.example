# HCX Platform Environment Configuration
# Copy this file to .env and update the values as needed

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=hcx
DB_USER=hcx_user
DB_PASSWORD=hcx_password
DB_URL=jdbc:postgresql://${DB_HOST}:${DB_PORT}/${DB_NAME}

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TOPIC_PREFIX=hcx
KAFKA_CONSUMER_GROUP=hcx-consumer-group

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# Application Ports
HCX_APIS_PORT=8080
API_GATEWAY_PORT=8090
DEMO_APP_PORT=3000
ONBOARDING_APP_PORT=3001

# Security Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=86400
ENCRYPTION_KEY=your-encryption-key-32-characters-long
SIGNING_KEY=your-signing-key-for-digital-signatures

# External Service URLs
REGISTRY_URL=http://hcx-apis:8080/registry
AUDIT_SERVICE_URL=http://hcx-apis:8080/audit
NOTIFICATION_SERVICE_URL=http://hcx-apis:8080/notification

# FHIR Configuration
FHIR_BASE_URL=http://hcx-apis:8080/fhir
FHIR_VERSION=R4
FHIR_VALIDATION_ENABLED=true

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=JSON
LOG_FILE_PATH=/var/log/hcx

# Monitoring Configuration
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true
ACTUATOR_ENDPOINTS_ENABLED=true

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# File Storage Configuration
FILE_STORAGE_TYPE=local
FILE_STORAGE_PATH=/var/hcx/files
FILE_MAX_SIZE=10MB

# Email Configuration (for notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@hcx-platform.com

# API Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Development/Testing Configuration
SPRING_PROFILES_ACTIVE=docker
DEBUG_MODE=false
TEST_MODE=false

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30

